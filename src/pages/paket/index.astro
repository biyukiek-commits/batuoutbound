---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import Icon from "../../components/Icon.astro";
import { packagesData } from "../../data/packages";
import { siteConfig } from "../../data/site";
import {
  generateOrganizationSchema,
  generateWebSiteSchema,
  generateWebPageSchema,
  generateBreadcrumbSchema
} from "../../utils/schema";

const pageTitle = "Paket Outbound Batu Malang | Pilihan Kegiatan dan Penawaran";
const pageDescription = "Lihat pilihan paket outbound Batu Malang, rincian aktivitas team building, durasi, fasilitas lengkap, dan konsultasikan penawaran harga terbaik via WhatsApp.";
const pageUrl = `${siteConfig.url}/paket/`;

const breadcrumbItems = [
  { name: "Paket Outbound", url: pageUrl }
];

const schemas = [
  generateOrganizationSchema(),
  generateWebSiteSchema(),
  generateWebPageSchema({
    title: pageTitle,
    description: pageDescription,
    url: pageUrl
  }),
  generateBreadcrumbSchema(breadcrumbItems)
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schemas={schemas}
>
  <Breadcrumb items={breadcrumbItems} />

  <!-- Page Header -->
  <section class="py-5 position-relative overflow-hidden" style="background-color: #0c0c0c; border-bottom: 1px solid var(--color-border);">
    <div class="container-xl">
      <div class="row align-items-center">
        <div class="col-lg-8">
          <div class="section-badge">Katalog Program Lengkap</div>
          <h1 class="display-5 fw-bold text-light mb-3">Pilihan Paket Outbound di Batu Malang</h1>
          <p class="lead text-muted-custom mb-0">
            Temukan paket yang dirancang khusus untuk memenuhi kebutuhan instansi kantor, sekolah, paguyuban, hingga keluarga besar dengan skenario kegiatan dinamis dan berkesan.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Package List Section -->
  <section class="section-padding" aria-labelledby="heading-daftar-paket">
    <div class="container-xl">
      <div class="row g-4 mb-5">
        {packagesData.map((pkg) => (
          <div class="col-lg-6 mb-4" id={pkg.slug}>
            <div class="card-dark h-100 p-4 p-md-5 d-flex flex-column position-relative">
              
              <!-- Badge -->
              {pkg.badge && (
                <div class="position-absolute top-0 end-0 m-4">
                  <span class={`badge ${pkg.isPopular ? "bg-warning text-dark fw-bold" : "bg-dark text-accent border border-secondary"}`}>
                    {pkg.badge}
                  </span>
                </div>
              )}

              <!-- Header & Target -->
              <div class="mb-3">
                <span class="small text-muted-custom text-uppercase tracking-wider fw-bold">
                  {pkg.targetAudience}
                </span>
                <h2 class="h3 text-light mt-1 mb-2">{pkg.title}</h2>
                <p class="text-muted-custom small mb-0">{pkg.summary}</p>
              </div>

              <!-- Quick Info Badges -->
              <div class="d-flex flex-wrap gap-2 mb-4 pb-3 border-bottom border-dark">
                <span class="badge bg-black text-light border border-secondary px-3 py-2 small d-inline-flex align-items-center gap-1">
                  <Icon name="clock" size={13} class="text-accent" />
                  <span>Durasi: {pkg.duration}</span>
                </span>
                <span class="badge bg-black text-light border border-secondary px-3 py-2 small d-inline-flex align-items-center gap-1">
                  <Icon name="users" size={13} class="text-accent" />
                  <span>{pkg.minParticipants}</span>
                </span>
              </div>

              <!-- Activities -->
              <div class="mb-4">
                <h3 class="h6 text-accent fw-bold text-uppercase mb-2" style="font-size: 0.8rem; letter-spacing: 0.05em;">
                  Simulasi & Aktivitas Utama:
                </h3>
                <ul class="list-unstyled small mb-0">
                  {pkg.activities.map((act) => (
                    <li class="d-flex align-items-start gap-2 mb-2 text-light">
                      <span class="text-accent mt-1 flex-shrink-0" aria-hidden="true">
                        <Icon name="check" size={13} />
                      </span>
                      <span>{act}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Recommended Venues -->
              <div class="mb-4">
                <h3 class="h6 text-muted-custom fw-bold text-uppercase mb-2" style="font-size: 0.8rem; letter-spacing: 0.05em;">
                  Rekomendasi Lokasi Venue:
                </h3>
                <p class="small text-light mb-0">
                  {pkg.recommendedLocations.join(" • ")}
                </p>
              </div>

              <!-- Pricing & Action -->
              <div class="pt-4 border-top border-dark mt-auto">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-3">
                  <div>
                    <span class="small text-muted-custom d-block">Estimasi Investasi:</span>
                    <span class="fw-bold text-accent fs-5">{pkg.priceNote}</span>
                  </div>
                </div>

                <div class="row g-2">
                  <div class="col-sm-6">
                    <a href={`/paket/${pkg.slug}/`} class="btn-outline-gold w-100 justify-content-center text-center py-2 px-3 small">
                      Lihat Detail Rundown &rarr;
                    </a>
                  </div>
                  <div class="col-sm-6">
                    <WhatsAppButton
                      variant={pkg.isPopular ? "gold" : "gold"}
                      packageTitle={pkg.title}
                      className="w-100 justify-content-center text-center py-2 px-3 small"
                      ariaLabel={`Tanya dan pesan paket ${pkg.title} via WhatsApp`}
                    >
                      Pesan via WhatsApp
                    </WhatsAppButton>
                  </div>
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>

      <!-- Faktor yang Memengaruhi Harga (PRD FR-03) -->
      <div class="card-dark p-4 p-md-5 border border-dark mb-5" style="background-color: var(--color-surface-2);">
        <h3 class="h4 text-light mb-3">Faktor yang Memengaruhi Biaya Paket Outbound</h3>
        <p class="text-muted-custom small mb-4">
          Kami berkomitmen memberikan penawaran harga yang adil, rasional, dan transparan. Berikut adalah faktor-faktor fleksibel yang menentukan nilai proposal penawaran Anda:
        </p>

        <div class="row g-4">
          <div class="col-md-3">
            <h4 class="h6 text-accent mb-1">1. Jumlah Peserta</h4>
            <p class="small text-muted-custom mb-0">Semakin besar jumlah rombongan peserta, semakin efisien biaya operasional per individu (economies of scale).</p>
          </div>
          <div class="col-md-3">
            <h4 class="h6 text-accent mb-1">2. Pilihan Venue</h4>
            <p class="small text-muted-custom mb-0">Setiap lokasi (hutan pinus, resort bintang, atau camping ground) memiliki kebijakan tarif sewa lapangan dan tiket masuk berbeda.</p>
          </div>
          <div class="col-md-3">
            <h4 class="h6 text-accent mb-1">3. Pilihan Konsumsi</h4>
            <p class="small text-muted-custom mb-0">Menu prasmanan khas pedesaan, barbeque malam, coffee break, atau penyediaan konsumsi secara mandiri oleh panitia.</p>
          </div>
          <div class="col-md-3">
            <h4 class="h6 text-accent mb-1">4. Fasilitas Tambahan</h4>
            <p class="small text-muted-custom mb-0">Kombinasi wahana petualangan (rafting/paintball), penginapan villa/hotel, seragam kaos, hingga dokumentasi drone.</p>
          </div>
        </div>
      </div>

      <!-- Quick WhatsApp CTA Banner -->
      <div class="p-4 rounded-4 text-center border border-dark" style="background-color: var(--color-surface);">
        <h3 class="h4 text-light mb-2">Ingin Menggabungkan Beberapa Aktivitas Sekaligus?</h3>
        <p class="text-muted-custom small mb-3">
          Konsultasikan ide rundown Anda bersama tim Master Game kami secara gratis melalui WhatsApp.
        </p>
        <WhatsAppButton
          variant="gold"
          size="md"
          customMessage="Halo Admin, saya ingin konsultasi paket kustom gabungan outbound di Batu Malang."
        >
          Konsultasi Paket Kustom Sekarang
        </WhatsAppButton>
      </div>

    </div>
  </section>
</BaseLayout>

