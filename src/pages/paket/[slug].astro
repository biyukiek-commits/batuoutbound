---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import Icon from "../../components/Icon.astro";
import { packagesData, type OutboundPackage } from "../../data/packages";
import { siteConfig } from "../../data/site";
import {
  generateOrganizationSchema,
  generateWebSiteSchema,
  generateWebPageSchema,
  generateBreadcrumbSchema,
  generateServiceSchema,
  generateFAQSchema
} from "../../utils/schema";

export function getStaticPaths() {
  return packagesData.map((pkg) => ({
    params: { slug: pkg.slug },
    props: { pkg }
  }));
}

interface Props {
  pkg: OutboundPackage;
}

const { pkg } = Astro.props;

const pageTitle = `${pkg.title} di Batu Malang | Paket Outbound`;
const pageDescription = `${pkg.summary} Dilengkapi rincian aktivitas, fasilitas termasuk, estimasi rundown, dan opsi penawaran resmi.`;
const pageUrl = `${siteConfig.url}/paket/${pkg.slug}/`;

const breadcrumbItems = [
  { name: "Paket Outbound", url: `${siteConfig.url}/paket/` },
  { name: pkg.title, url: pageUrl }
];

const schemas = [
  generateOrganizationSchema(),
  generateWebSiteSchema(),
  generateWebPageSchema({
    title: pageTitle,
    description: pageDescription,
    url: pageUrl
  }),
  generateBreadcrumbSchema(breadcrumbItems),
  generateServiceSchema({
    name: pkg.title,
    serviceType: "Paket Kegiatan Outbound & Team Building",
    description: pkg.summary,
    url: pageUrl
  }),
  generateFAQSchema(pkg.packageFaqs)
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={pkg.image}
  schemas={schemas}
>
  <Breadcrumb items={breadcrumbItems} />

  <!-- Package Detail Hero -->
  <section class="page-hero-section text-light" aria-label={`Hero Detail ${pkg.title}`}>
    <img
      src={pkg.image}
      alt={pkg.altText}
      class="page-hero-bg"
      width="1600"
      height="600"
      loading="eager"
      fetchpriority="high"
    />
    <div class="page-hero-overlay" aria-hidden="true"></div>

    <div class="container-xl page-hero-content">
      <div class="row align-items-center gy-4">
        <div class="col-lg-8">
          <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="section-badge mb-0">Rincian Paket</span>
            {pkg.badge && (
              <span class="badge bg-warning text-dark fw-bold px-3 py-2">
                {pkg.badge}
              </span>
            )}
          </div>

          <h1 class="display-5 fw-bold text-light mb-3">{pkg.title}</h1>
          <p class="lead text-light text-opacity-90 mb-4" style="line-height: 1.7;">{pkg.summary}</p>

          <div class="d-flex flex-wrap gap-2 text-light small pb-2">
            <span class="badge bg-dark border border-secondary px-3 py-2 d-inline-flex align-items-center gap-1">
              <Icon name="clock" size={13} class="text-accent" />
              <span>Durasi: {pkg.duration}</span>
            </span>
            <span class="badge bg-dark border border-secondary px-3 py-2 d-inline-flex align-items-center gap-1">
              <Icon name="users" size={13} class="text-accent" />
              <span>Kapasitas: {pkg.minParticipants}</span>
            </span>
            <span class="badge bg-dark border border-secondary px-3 py-2 d-inline-flex align-items-center gap-1">
              <Icon name="target" size={13} class="text-accent" />
              <span>Sasaran: {pkg.targetAudience}</span>
            </span>
          </div>
        </div>

        <div class="col-lg-4 text-lg-end">
          <div class="card-dark p-4 border border-dark text-start">
            <span class="small text-muted-custom d-block mb-1">Estimasi Harga Investasi:</span>
            <div class="h4 text-accent fw-bold mb-3">{pkg.priceNote}</div>
            <WhatsAppButton
              variant="gold"
              size="md"
              packageTitle={pkg.title}
              className="w-100 justify-content-center text-center"
              ariaLabel={`Pesan dan minta proposal paket ${pkg.title} via WhatsApp`}
            >
              Minta Proposal & Rundown WA
            </WhatsAppButton>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Package Main Content -->
  <section class="section-padding">
    <div class="container-xl">
      <div class="row g-5">
        
        <!-- Left Column: Details -->
        <div class="col-lg-8">
          
          <!-- Image -->
          <div class="rounded-4 overflow-hidden mb-5 border border-dark">
            <img
              src={pkg.image}
              alt={pkg.altText}
              class="w-100 object-fit-cover"
              style="max-height: 440px;"
              width="800"
              height="440"
            />
          </div>

          <!-- Activities Section -->
          <div class="mb-5">
            <h2 class="h2 text-light mb-3">Simulasi & Aktivitas Program</h2>
            <p class="text-muted-custom">
              Program {pkg.title} disusun secara berjenjang untuk memastikan setiap peserta dapat beradaptasi dan terlibat aktif dalam dinamika tim:
            </p>
            <div class="p-4 rounded-3 border border-dark" style="background-color: var(--color-surface);">
              <ul class="list-unstyled mb-0">
                {pkg.activities.map((act) => (
                  <li class="d-flex align-items-start gap-3 mb-3 text-light">
                    <span class="text-accent mt-1 flex-shrink-0" aria-hidden="true">
                      <Icon name="check" size={14} />
                    </span>
                    <div>
                      <strong>{act}</strong>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Rundown Table -->
          <div class="mb-5">
            <h2 class="h2 text-light mb-3">Estimasi Rundown Acara</h2>
            <p class="text-muted-custom small mb-3">
              *Jadwal di bawah ini merupakan estimasi alur standar yang dapat disesuaikan dengan waktu kedatangan rombongan Anda.
            </p>
            <div class="table-responsive rounded-3 border border-dark overflow-hidden">
              <table class="table table-dark table-striped mb-0 small">
                <thead>
                  <tr class="text-accent border-bottom border-secondary">
                    <th style="width: 28%;">Waktu</th>
                    <th style="width: 32%;">Agenda Kegiatan</th>
                    <th>Keterangan Simulasi</th>
                  </tr>
                </thead>
                <tbody>
                  {pkg.rundownEstimate.map((item) => (
                    <tr>
                      <td class="text-nowrap fw-semibold">{item.time}</td>
                      <td class="text-light fw-bold">{item.activity}</td>
                      <td class="text-muted-custom">{item.desc}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Facilities Comparison -->
          <div class="mb-5">
            <h2 class="h2 text-light mb-3">Rincian Fasilitas Paket</h2>
            <div class="row g-4">
              <div class="col-md-6">
                <div class="card-dark p-4 border border-dark h-100">
                  <h3 class="h5 text-success mb-3 d-flex align-items-center gap-2">
                    <Icon name="check" size={16} class="text-success" />
                    <span>Fasilitas Termasuk (Included)</span>
                  </h3>
                  <ul class="list-unstyled small mb-0">
                    {pkg.facilitiesIncluded.map((fac) => (
                      <li class="d-flex align-items-start gap-2 mb-2 text-light">
                        <span class="text-success" aria-hidden="true">•</span>
                        <span>{fac}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="col-md-6">
                <div class="card-dark p-4 border border-dark h-100">
                  <h3 class="h5 text-muted-custom mb-3 d-flex align-items-center gap-2">
                    <Icon name="cross" size={16} class="text-muted-custom" />
                    <span>Fasilitas Tidak Termasuk (Excluded)</span>
                  </h3>
                  <ul class="list-unstyled small mb-0">
                    {pkg.facilitiesExcluded.map((fac) => (
                      <li class="d-flex align-items-start gap-2 mb-2 text-muted-custom">
                        <span class="text-muted-custom" aria-hidden="true">•</span>
                        <span>{fac}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <!-- Participant Requirements -->
          <div class="mb-5">
            <h2 class="h2 text-light mb-3">Ketentuan & Perlengkapan Peserta</h2>
            <div class="p-4 rounded-3 border border-dark" style="background-color: var(--color-surface-2);">
              <ul class="list-unstyled small mb-0">
                {pkg.participantRequirements.map((req) => (
                  <li class="d-flex align-items-start gap-2 mb-2 text-light">
                    <span class="text-accent mt-1 flex-shrink-0" aria-hidden="true">
                      <Icon name="arrow-right" size={13} />
                    </span>
                    <span>{req}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Package FAQs -->
          <div class="mb-4">
            <h2 class="h2 text-light mb-3">FAQ Khusus {pkg.title}</h2>
            <FAQAccordion faqs={pkg.packageFaqs.map((f, i) => ({ id: `pkg-${i}`, question: f.question, answer: f.answer }))} />
          </div>

        </div>

        <!-- Right Column: Sidebar -->
        <div class="col-lg-4">
          <div class="position-sticky" style="top: calc(var(--header-height) + 24px);">
            
            <!-- Reservation Card -->
            <div class="card-dark p-4 border border-dark mb-4">
              <h3 class="h5 text-light mb-3">Reservasi & Konsultasi</h3>
              <p class="small text-muted-custom mb-3">
                Hubungi tim kami untuk menanyakan ketersediaan tanggal, survei lokasi, atau meminta penawaran proposal resmi:
              </p>
              
              <div class="p-3 rounded-3 mb-3 bg-black border border-dark">
                <span class="small text-muted-custom d-block">Harga Estimasi:</span>
                <span class="text-accent fw-bold fs-6">{pkg.priceNote}</span>
              </div>

              <WhatsAppButton
                variant="gold"
                size="md"
                packageTitle={pkg.title}
                className="w-100 justify-content-center text-center mb-2"
                ariaLabel={`Chat WhatsApp untuk booking ${pkg.title}`}
              >
                Chat WhatsApp Langsung
              </WhatsAppButton>

              <div class="text-center small text-muted-custom mt-2">
                Respon cepat setiap hari (07.30 - 21.00 WIB)
              </div>
            </div>

            <!-- Recommended Venues Card -->
            <div class="card-dark p-4 border border-dark">
              <h3 class="h6 text-accent fw-bold text-uppercase mb-3">Rekomendasi Venue Kota Batu</h3>
              <ul class="list-unstyled small mb-0">
                {pkg.recommendedLocations.map((loc) => (
                  <li class="d-flex align-items-start gap-2 mb-2 text-light">
                    <span class="text-accent mt-1 flex-shrink-0">
                      <Icon name="pin" size={13} />
                    </span>
                    <span>{loc}</span>
                  </li>
                ))}
              </ul>
              <div class="pt-3 border-top border-dark mt-3">
                <a href="/layanan/" class="small text-accent text-decoration-none">
                  Lihat Seluruh Kategori Layanan &rarr;
                </a>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

