---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import { articlesData } from "../../data/articles";
import { siteConfig } from "../../data/site";
import {
  generateOrganizationSchema,
  generateWebSiteSchema,
  generateWebPageSchema,
  generateBreadcrumbSchema
} from "../../utils/schema";

const pageTitle = "Blog & Panduan Outbound Batu Malang | Edukasi & Tips Gathering";
const pageDescription = "Baca kumpulan artikel edukatif, panduan memilih paket outbound di Batu Malang, rundown gathering kantor, dan manfaat team building untuk soliditas karyawan.";
const pageUrl = `${siteConfig.url}/blog/`;

const breadcrumbItems = [
  { name: "Blog", url: pageUrl }
];

const schemas = [
  generateOrganizationSchema(),
  generateWebSiteSchema(),
  generateWebPageSchema({
    title: pageTitle,
    description: pageDescription,
    url: pageUrl
  }),
  generateBreadcrumbSchema(breadcrumbItems)
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schemas={schemas}
>
  <Breadcrumb items={breadcrumbItems} />

  <!-- Page Header -->
  <section class="page-hero-section text-light" aria-label="Hero Blog & Panduan">
    <img
      src="/images/hero/hero-blog.webp"
      alt="Panduan dan inspirasi outbound team building di kawasan Batu Malang"
      class="page-hero-bg"
      width="1600"
      height="600"
      loading="eager"
      fetchpriority="high"
    />
    <div class="page-hero-overlay" aria-hidden="true"></div>

    <div class="container-xl page-hero-content">
      <div class="row align-items-center">
        <div class="col-lg-8">
          <div class="section-badge">Wawasan & Panduan Praktis</div>
          <h1 class="display-5 fw-bold text-light mb-3">Blog Seputar Outbound Batu Malang</h1>
          <p class="lead text-light text-opacity-90 mb-0" style="line-height: 1.7;">
            Panduan lengkap, inspirasi rundown kegiatan luar ruang, tips memilih lokasi gathering, serta ulasan manfaat pelatihan SDM berbasis alam terbuka.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Listing -->
  <section class="section-padding">
    <div class="container-xl">
      <div class="row g-4 mb-5">
        {articlesData.map((article) => (
          <div class="col-lg-4 col-md-6 mb-4">
            <article class="card-dark h-100 overflow-hidden d-flex flex-column border border-dark">
              
              <div class="ratio ratio-16x9 rounded-3 overflow-hidden mb-3 position-relative" style="background-color: #1a1a1a;">
                <img
                  src={article.image}
                  alt={article.altText}
                  loading="lazy"
                  width="600"
                  height="338"
                  class="w-100 h-100 object-fit-cover blog-thumb"
                />
                <div class="position-absolute top-0 start-0 m-2">
                  <span class="badge bg-black text-accent border border-secondary small">
                    {article.category}
                  </span>
                </div>
              </div>

              <div class="d-flex align-items-center gap-2 small text-muted-custom mb-2">
                <time datetime={article.publishDate}>{article.publishDateFormatted}</time>
                <span>&bull;</span>
                <span>{article.readTime}</span>
              </div>

              <h2 class="h5 mb-2">
                <a href={`/blog/${article.slug}/`} class="text-light text-decoration-none article-link">
                  {article.title}
                </a>
              </h2>

              <p class="small text-muted-custom mb-4 flex-grow-1">
                {article.excerpt}
              </p>

              <div class="pt-3 border-top border-dark mt-auto d-flex align-items-center justify-content-between">
                <span class="small text-muted-custom">Oleh: {article.author}</span>
                <a href={`/blog/${article.slug}/`} class="small fw-semibold text-accent text-decoration-none d-inline-flex align-items-center gap-1">
                  <span>Baca Selengkapnya</span>
                  <span>&rarr;</span>
                </a>
              </div>

            </article>
          </div>
        ))}
      </div>

      <!-- Contextual CTA -->
      <div class="p-4 p-md-5 rounded-4 text-center border border-dark" style="background-color: var(--color-surface);">
        <h3 class="h4 text-light mb-2">Butuh Bantuan Menyusun Rundown Acara Khusus?</h3>
        <p class="text-muted-custom small mx-auto mb-4" style="max-width: 620px;">
          Tim kami siap membantu merancang agenda gathering atau outbound kantor Anda tanpa repot. Konsultasikan gratis sekarang.
        </p>
        <WhatsAppButton
          variant="gold"
          size="md"
          customMessage="Halo Admin, saya membaca blog outbound dan ingin konsultasi rundown kegiatan di Batu."
        >
          Konsultasi Gratis via WhatsApp
        </WhatsAppButton>
      </div>

    </div>
  </section>

  <style>
    .blog-thumb {
      transition: transform 0.4s ease;
    }
    .card-dark:hover .blog-thumb {
      transform: scale(1.05);
    }
    .article-link:hover {
      color: var(--color-accent) !important;
    }
  </style>
</BaseLayout>

