---
import type { OutboundPackage } from "../data/packages";
import WhatsAppButton from "./WhatsAppButton.astro";

export interface Props {
  pkg: OutboundPackage;
}

const { pkg } = Astro.props;
---

<div class="col-lg-4 col-md-6 mb-4">
  <div class="card-dark position-relative h-100">
    
    <!-- Top Badge if any -->
    {pkg.badge && (
      <div class="position-absolute top-0 end-0 m-3">
        <span class={`badge ${pkg.isPopular ? "bg-warning text-dark fw-bold" : "bg-dark text-accent border border-secondary"}`}>
          {pkg.badge}
        </span>
      </div>
    )}

    <!-- Package Title & Target -->
    <div class="mb-3">
      <span class="small text-muted-custom text-uppercase tracking-wider fw-bold">
        {pkg.targetAudience}
      </span>
      <h3 class="h4 mt-1 mb-2 text-light">{pkg.title}</h3>
      <p class="small text-muted-custom mb-0">{pkg.summary}</p>
    </div>

    <!-- Duration & Participants Badges -->
    <div class="d-flex flex-wrap gap-2 mb-3 pb-3 border-bottom border-dark">
      <span class="badge bg-black text-light border border-secondary px-2 py-1 small">
        ⏱ {pkg.duration}
      </span>
      <span class="badge bg-black text-light border border-secondary px-2 py-1 small">
        👥 {pkg.minParticipants}
      </span>
    </div>

    <!-- Key Activities List -->
    <div class="mb-3 flex-grow-1">
      <div class="text-xs text-accent fw-bold text-uppercase mb-2" style="font-size: 0.78rem; letter-spacing: 0.05em;">
        Simulasi & Aktivitas Utama:
      </div>
      <ul class="list-unstyled small mb-0">
        {pkg.activities.slice(0, 4).map((act) => (
          <li class="d-flex align-items-start gap-2 mb-1 text-light">
            <span class="text-accent" aria-hidden="true">✓</span>
            <span>{act}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Price note & WhatsApp CTA -->
    <div class="pt-3 border-top border-dark mt-auto">
      <div class="mb-3">
        <span class="d-block small text-muted-custom">Estimasi Investasi:</span>
        <span class="fw-bold text-accent" style="font-size: 0.95rem;">
          {pkg.priceNote}
        </span>
      </div>

      <div class="d-grid gap-2">
        <WhatsAppButton
          variant={pkg.isPopular ? "gold" : "outline"}
          packageTitle={pkg.title}
          className="w-100 justify-content-center text-center"
          ariaLabel={`Tanya dan pesan paket ${pkg.title} melalui WhatsApp`}
        >
          Pesan Paket Ini via WA
        </WhatsAppButton>
      </div>
    </div>

  </div>
</div>

