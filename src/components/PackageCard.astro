---
import type { OutboundPackage } from "../data/packages";
import WhatsAppButton from "./WhatsAppButton.astro";
import Icon from "./Icon.astro";

export interface Props {
  pkg: OutboundPackage;
}

const { pkg } = Astro.props;
---

<div class="col-lg-4 col-md-6 mb-4">
  <div class="card-dark position-relative h-100 d-flex flex-column">
    
    <!-- Package Thumbnail Image with Hover Effect & Badge -->
    <a href={`/paket/${pkg.slug}/`} class="d-block text-decoration-none mb-3" aria-label={`Lihat detail paket ${pkg.title}`}>
      <div class="ratio ratio-16x9 rounded-3 overflow-hidden position-relative" style="background-color: #1a1a1a;">
        <img
          src={pkg.image}
          alt={pkg.altText}
          loading="lazy"
          width="600"
          height="338"
          class="w-100 h-100 object-fit-cover package-thumb-img"
        />
        {pkg.badge && (
          <div class="position-absolute top-0 end-0 m-2 z-1">
            <span class={`badge ${pkg.isPopular ? "bg-warning text-dark fw-bold" : "bg-black text-accent border border-secondary"} small`}>
              {pkg.badge}
            </span>
          </div>
        )}
      </div>
    </a>

    <!-- Package Title & Target -->
    <div class="mb-3">
      <span class="small text-muted-custom text-uppercase tracking-wider fw-bold">
        {pkg.targetAudience}
      </span>
      <h3 class="h4 mt-1 mb-2">
        <a href={`/paket/${pkg.slug}/`} class="text-light text-decoration-none hover-accent">
          {pkg.title}
        </a>
      </h3>
      <p class="small text-light text-opacity-80 mb-0" style="line-height: 1.6;">{pkg.summary}</p>
    </div>

    <!-- Duration & Participants Badges -->
    <div class="d-flex flex-wrap gap-2 mb-3 pb-3 border-bottom border-dark">
      <span class="badge bg-black text-light border border-secondary px-2 py-1 small d-inline-flex align-items-center gap-1">
        <Icon name="clock" size={13} class="text-accent" />
        <span>{pkg.duration}</span>
      </span>
      <span class="badge bg-black text-light border border-secondary px-2 py-1 small d-inline-flex align-items-center gap-1">
        <Icon name="users" size={13} class="text-accent" />
        <span>{pkg.minParticipants}</span>
      </span>
    </div>

    <!-- Key Activities List -->
    <div class="mb-3 flex-grow-1">
      <div class="text-xs text-accent fw-bold text-uppercase mb-2" style="font-size: 0.78rem; letter-spacing: 0.05em;">
        Simulasi & Aktivitas Utama:
      </div>
      <ul class="list-unstyled small mb-0">
        {pkg.activities.slice(0, 4).map((act) => (
          <li class="d-flex align-items-start gap-2 mb-1 text-light">
            <span class="text-accent mt-1 flex-shrink-0" aria-hidden="true">
              <Icon name="check" size={13} />
            </span>
            <span>{act}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Price note & Action Buttons -->
    <div class="pt-3 border-top border-dark mt-auto">
      <div class="mb-3">
        <span class="d-block small text-muted-custom">Estimasi Investasi:</span>
        <span class="fw-bold text-accent" style="font-size: 0.95rem;">
          {pkg.priceNote}
        </span>
      </div>

      <div class="row g-2">
        <div class="col-6">
          <a
            href={`/paket/${pkg.slug}/`}
            class="btn-outline-gold w-100 justify-content-center text-center py-2 px-2 small text-decoration-none d-inline-flex align-items-center"
          >
            <span>Detail Rundown</span>
          </a>
        </div>
        <div class="col-6">
          <WhatsAppButton
            variant={pkg.isPopular ? "gold" : "outline"}
            packageTitle={pkg.title}
            className="w-100 justify-content-center text-center py-2 px-2 small"
            ariaLabel={`Tanya dan pesan paket ${pkg.title} melalui WhatsApp`}
          >
            Pesan via WA
          </WhatsAppButton>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  .package-thumb-img {
    transition: transform 0.4s ease;
  }
  .card-dark:hover .package-thumb-img {
    transform: scale(1.05);
  }
  .hover-accent:hover {
    color: var(--color-accent) !important;
  }
</style>
