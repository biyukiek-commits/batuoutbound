---
import type { ArticlePreview } from "../data/articles";

export interface Props {
  article: ArticlePreview;
}

const { article } = Astro.props;
---

<div class="col-lg-4 col-md-6 mb-4">
  <article class="card-dark h-100 overflow-hidden d-flex flex-column">
    
    <!-- Thumbnail Image Container -->
    <div class="ratio ratio-16x9 rounded-3 overflow-hidden mb-3 position-relative" style="background-color: #1a1a1a;">
      <img
        src={article.image}
        alt={article.altText}
        loading="lazy"
        width="600"
        height="338"
        class="w-100 h-100 object-fit-cover article-thumb"
      />
      <div class="position-absolute top-0 start-0 m-2">
        <span class="badge bg-black text-accent border border-secondary small">
          {article.category}
        </span>
      </div>
    </div>

    <!-- Meta Details (Date & Read time) -->
    <div class="d-flex align-items-center gap-2 small text-muted-custom mb-2">
      <time datetime={article.publishDate}>{article.publishDateFormatted}</time>
      <span>&bull;</span>
      <span>{article.readTime}</span>
    </div>

    <!-- Title & Excerpt -->
    <h3 class="h5 mb-2">
      <a href={`/blog/#${article.slug}`} class="text-light text-decoration-none article-title-link">
        {article.title}
      </a>
    </h3>
    <p class="small text-muted-custom mb-3 flex-grow-1">
      {article.excerpt}
    </p>

    <!-- Read more footer -->
    <div class="pt-3 border-top border-dark mt-auto">
      <a href={`/blog/#${article.slug}`} class="small fw-semibold text-accent d-inline-flex align-items-center gap-1 text-decoration-none">
        <span>Baca Selengkapnya</span>
        <span>&rarr;</span>
      </a>
    </div>

  </article>
</div>

<style>
  .article-thumb {
    transition: transform 0.35s ease;
  }
  .card-dark:hover .article-thumb {
    transform: scale(1.05);
  }
  .article-title-link:hover {
    color: var(--color-accent) !important;
  }
</style>

