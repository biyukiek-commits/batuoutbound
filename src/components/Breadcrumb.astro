---
export interface BreadcrumbItem {
  name: string;
  url?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="py-3">
  <div class="container-xl">
    <ol class="breadcrumb mb-0 small" itemscope itemtype="https://schema.org/BreadcrumbList">
      <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/" class="text-muted-custom text-decoration-none" itemprop="item">
          <span itemprop="name">Beranda</span>
        </a>
        <meta itemprop="position" content="1" />
      </li>

      {items.map((item, index) => {
        const position = index + 2;
        const isLast = index === items.length - 1;

        return (
          <li
            class={`breadcrumb-item ${isLast ? "active text-accent" : ""}`}
            itemprop="itemListElement"
            itemscope
            itemtype="https://schema.org/ListItem"
            aria-current={isLast ? "page" : undefined}
          >
            {!isLast && item.url ? (
              <a href={item.url} class="text-muted-custom text-decoration-none" itemprop="item">
                <span itemprop="name">{item.name}</span>
              </a>
            ) : (
              <span itemprop="name" class={isLast ? "text-accent fw-semibold" : ""}>{item.name}</span>
            )}
            <meta itemprop="position" content={position.toString()} />
          </li>
        );
      })}
    </ol>
  </div>
</nav>

<style>
  .breadcrumb-item + .breadcrumb-item::before {
    color: var(--color-muted);
    content: "›";
    font-size: 1.1rem;
    line-height: 1;
    vertical-align: middle;
  }
</style>

